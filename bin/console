#!/usr/bin/env php
<?php

require __DIR__ . '/../vendor/autoload.php';

use App\Command\SearchProductsCommand;
use App\ElasticStorage;
use Symfony\Component\Console\Application;


$storageService = new ElasticStorage();

$application = new Application();

$application->add(new SearchProductsCommand($storageService));

try {
    $application->run();
} catch (\Exception $exception) {
    echo $exception->getMessage();
}
