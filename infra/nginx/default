server {
    listen 80;
    server_name _;  # Обрабатывает все домены

    root /var/www/cicd-makhov-2025/current;  # Укажите путь к директории с вашим index.php
    index index.php;

    location / {
        try_files $uri $uri/ /index.php?$query_string;  # Перенаправление всех запросов на index.php
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;  # Замените на вашу версию PHP
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }

    location ~ /\.ht {
        deny all;  # Запрет доступа к файлам .htaccess
    }
}
