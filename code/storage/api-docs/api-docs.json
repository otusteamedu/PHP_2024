        },
        "version": "1.0.0"
    },
    "paths": {
        "/api/request": {
            "post": {
                "summary": "Create a new request",
                "description": "This endpoint allows you to create a new request and enqueue it for processing.",
                "operationId": "1dd17c17e05d17f7b3232c13f0a452d1",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "data"
                                ],
                                "properties": {
                                    "data": {
                                        "type": "string",
                                        "example": "payload data here"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Request created successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "request_id": {
                                            "type": "integer",
                                            "example": 1
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "default": {
                        "description": "Unexpected error",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/api/status/{id}": {
            "get": {
                "tags": [
                    "Requests"
                ],
                "summary": "Check request status",
                "operationId": "2b188f4365f8c797b0d49717b0547582",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Status retrieved successfully"
                    }
                }
            }
        },
        "/api/update/{id}/{status}": {
            "put": {
                "summary": "Update request status",
                "description": "Updates the status of the request identified by its ID.",
                "operationId": "e925be944956829715513320d6a356d3",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "The identifier of the request.",
                        "required": true,
                        "example": 1
                    },
                    {
                        "name": "status",
                        "in": "path",
                        "description": "The new status of the request.",
                        "required": true,
                        "example": "completed"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Request status updated successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "Ok"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Request not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "Request not found"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Unexpected error",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        }
    }
}