{
    "openapi": "3.0.0",
    "info": {
        "title": "Your API Title",
        "description": "A detailed description of your API.",
        "contact": {
            "name": "Your Name",
            "url": "https://yourwebsite.com",
            "email": "your-email@example.com"
        },
        "license": {
