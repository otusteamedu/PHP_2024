<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Queue Request Form</title>
    <!-- Подключение Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            padding: 20px;
        }

        .status {
            margin-top: 20px;
            font-weight: bold;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1 class="text-center mb-4">Queue Request Form</h1>
            <form id="requestForm" class="mb-3">
                <div class="mb-3">
                    <label for="data" class="form-label">Enter Data:</label>
                    <input type="text" class="form-control" id="data" name="data" placeholder="Enter anything" required>
                </div>
                <button type="submit" class="btn btn-primary w-100">Submit</button>
            </form>

            <div class="alert alert-info status" id="status" role="alert">
                <!-- Здесь будет отображаться статус -->
            </div>
        </div>
    </div>
</div>

<!-- Подключение Bootstrap 5 JS (необязательно, если не используются компоненты JS) -->
{# <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script> #}

<script>
    document.getElementById('requestForm').addEventListener('submit', function (e) {
        e.preventDefault();

        const data = document.getElementById('data').value;

        fetch('/api/v1/request', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: `data=${encodeURIComponent(data)}`,
        })
            .then(response => response.json())
            .then(data => {
                const requestId = data.request_id;
                const statusElement = document.getElementById('status');
                statusElement.innerText = `Request ID: ${requestId}. Checking status...`;
                statusElement.classList.remove('alert-success', 'alert-danger');
                statusElement.classList.add('alert-info');

                // Периодическая проверка статуса
                const interval = setInterval(() => {
                    fetch(`/api/v1/request/${requestId}`)
                        .then(response => response.json())
                        .then(statusData => {
                            if (statusData.status === 'completed') {
                                statusElement.innerText = `Request ID: ${requestId}. Status: Completed.`;
                                statusElement.classList.remove('alert-warning');
                                statusElement.classList.add('alert-success');
                                clearInterval(interval);
                            } else if (statusData.status === 'processing') {
                                statusElement.innerText = `Request ID: ${requestId}. Status: Processing...`;
                                statusElement.classList.remove('alert-info');
                                statusElement.classList.add('alert-warning');
                            } else if (statusData.status === 'pending') {
                                statusElement.innerText = `Request ID: ${requestId}. Status: Pending...`;
                            } else {
                                statusElement.innerText = `Request ID: ${requestId}. Status: Not Found.`;
                                statusElement.classList.remove('alert-info');
                                statusElement.classList.add('alert-danger');
                                clearInterval(interval);
                            }
                        })
                        .catch(error => {
                            console.error('Error checking status:', error);
                            statusElement.innerText = 'Error checking status.';
                            statusElement.classList.remove('alert-info');
                            statusElement.classList.add('alert-danger');
                            clearInterval(interval);
                        });
                }, 2000); // Проверка каждые 2 секунды
            })
            .catch(error => {
                console.error('Error submitting request:', error);
                const statusElement = document.getElementById('status');
                statusElement.innerText = 'Error submitting request.';
                statusElement.classList.remove('alert-info');
                statusElement.classList.add('alert-danger');
            });
    });
</script>
</body>
</html>