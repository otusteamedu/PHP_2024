<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Queue Request Form</title>
    <!-- Подключение Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            padding: 20px;
        }
        .status {
            margin-top: 20px;
            font-weight: bold;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1 class="text-center mb-4">Queue Request Form</h1>
            <form id="requestForm" class="mb-3">
                <div class="mb-3">
                    <label for="dateFrom" class="form-label">Enter date from:</label>
                    <input type="date" class="form-control" id="dateFrom" name="dateFrom"
                           placeholder="01.03.2025" required>
                </div>
                <div class="mb-3">
                    <label for="dateTo" class="form-label">Enter date to:</label>
                    <input type="date" class="form-control" id="dateTo" name="dateTo" placeholder="11.03.2025" required>
                </div>
{#                <div class="mb-3">#}
{#                    <label for="data" class="form-label">Enter Data:</label>#}
{#                    <textarea class="form-control" id="data" name="data" placeholder="Enter json data..." rows="3"#}
{#                              required></textarea>#}
{#                </div>#}
                <button type="submit" class="btn btn-primary w-100">Submit</button>
            </form>

            <div class="alert alert-info status visually-hidden" id="status" role="alert">
                <!-- Здесь будет отображаться статус -->
            </div>
        </div>
    </div>
</div>

<!-- Подключение Bootstrap 5 JS (необязательно, если не используются компоненты JS) -->
{# <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script> #}

<script>
    document.getElementById('requestForm').addEventListener('submit', function (e) {
        e.preventDefault();

        const statusElement = document.getElementById('status');

        const formData = new FormData(this);
        const dataObject = {};
        formData.forEach((value, key) => dataObject[key] = value);
        const dataJson = JSON.stringify(dataObject);

        //console.log(dataJson);

        statusElement.innerText = 'Sending request...';

        fetch('/api/v1/request', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: `data=${encodeURIComponent(dataJson)}`,
        }).then(response => response.text())
            .then(responseText => {
                statusElement.innerText = responseText;
                statusElement.classList.remove('visually-hidden', 'alert-info');
                statusElement.classList.add('alert-success');
                this.reset();
            })
            .catch(error => {
                console.error('Error submitting request:', error);
                statusElement.innerText = 'Error submitting request.';
                statusElement.classList.remove('alert-info');
                statusElement.classList.add('alert-danger');
            });
    });
</script>
</body>
</html>