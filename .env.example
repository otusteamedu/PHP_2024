APP_ENV=%APP_ENV%                  
APP_SECRET=APP_SECRET
SERVER_URL=%SERVER_NAME%         

APP_HTTPS_PORT=443
APP_HTTP_PORT=80
SITE_URL=SITE_URL
WEB_HOOK_ROUT_PREFIX=WEB_HOOK_ROUT_PREFIX

SHOPPING_TOGETHER_BOT_TELEGRAM_TOKEN=SHOPPING_TOGETHER_BOT_TELEGRAM_TOKEN
SHOPPING_TOGETHER_BOT_WEB_HOOK_ROUT=${WEB_HOOK_ROUT_PREFIX}${SHOPPING_TOGETHER_BOT_TELEGRAM_TOKEN}

PROJECT_NAME=PROJECT_NAME
PHP_CONTAINER_NAME=php-${PROJECT_NAME}-${APP_ENV}
NGINX_CONTAINER_NAME=nginx-${PROJECT_NAME}-${APP_ENV}
POSTGRES_CONTAINER_NAME=postgres-${PROJECT_NAME}-${APP_ENV}
RABBITMQ_CONTAINER_NAME=rabbitmq-${PROJECT_NAME}-${APP_ENV}
SUPERVISOR_CONTAINER_NAME=supervisor-${PROJECT_NAME}-${APP_ENV}

PGADMIN_EMAIL=PGADMIN_EMAIL
PGADMIN_PASSWORD=PGADMIN_PASSWORD
PGADMIN_CONFIG_SERVER_MODE=False
PGADMIN_CONTAINER_NAME=pgadmin-${PROJECT_NAME}-${APP_ENV}
PGADMIN_PORT=PGADMIN_PORT

POSTGRES_DB=${PROJECT_NAME}
POSTGRES_USER=POSTGRES_USER
POSTGRES_PASSWORD=POSTGRES_PASS
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_CONTAINER_NAME}:5432/${POSTGRES_DB}?serverVersion=15&charset=utf8

RABBITMQ_USER=user
RABBITMQ_PASSWORD=password
RABBITMQ_HOST=${RABBITMQ_CONTAINER_NAME}
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:5672

MAILER_DSN=null://null

LOCK_DSN=flock

MESSENGER_DOCTRINE_TRANSPORT_DSN=doctrine://default
